# ─── Supabase ────────────────────────────────────────────────────────────────
# Get from https://app.supabase.com/project/<your-project>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── App URL (your Vercel web deployment) ─────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://echo-self.app

# ─── RevenueCat (In-App Purchases via StoreKit / Google Play Billing) ─────────
# Get from https://app.revenuecat.com → Project → API Keys
# These are PUBLIC keys — safe to bundle into the app binary (not secrets).
# iOS:     Platform key from RevenueCat → Project → Apps → iOS
# Android: Platform key from RevenueCat → Project → Apps → Android
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Product IDs to configure in App Store Connect / Google Play Console:
#   com.echoself.app.premium.monthly  → $12.00 / month  (auto-renewable subscription)
#   com.echoself.app.premium.yearly   → $99.00 / year   (auto-renewable subscription)
#
# RevenueCat Entitlement:  "premium"
# RevenueCat Offering:     "default"  (monthly + annual packages)

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# Get from https://sentry.io → Settings → Projects → <project> → Client Keys
EXPO_PUBLIC_SENTRY_DSN=

# ─── PostHog (optional) ───────────────────────────────────────────────────────
# Get from https://app.posthog.com → Project Settings → API Keys
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── EAS Build secrets (set via `eas secret:create`, never in this file) ──────
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# GOOGLE_SERVICE_ACCOUNT_KEY=<base64-encoded JSON>
