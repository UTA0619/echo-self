default_platform(:android)

platform :android do
  desc "Build and upload to Play Console internal testing"
  lane :beta do
    # Next versionCode from the Play Console (internal track). Falls back to 0
    # on a brand-new app where the track has no releases yet.
    codes = begin
      google_play_track_version_codes(track: "internal")
    rescue StandardError
      [0]
    end
    build_number = (codes.max || 0) + 1

    # Flutter build (run from apps/mobile, two levels up from android/fastlane)
    sh("cd ../.. && flutter build appbundle --release " \
       "--build-number=#{build_number} " \
       "--dart-define-from-file=.env.production")

    upload_to_play_store(
      track: "internal",
      aab: "../../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload to production with store listing metadata (created as draft)"
  lane :release do
    codes = begin
      google_play_track_version_codes(track: "production")
    rescue StandardError
      [0]
    end
    build_number = (codes.max || 0) + 1

    sh("cd ../.. && flutter build appbundle --release " \
       "--build-number=#{build_number} " \
       "--dart-define-from-file=.env.production")

    upload_to_play_store(
      track: "production",
      # Mirror the iOS lane's automatic_release: false — the release is
      # created as a draft and rolled out manually from the Play Console.
      release_status: "draft",
      aab: "../../build/app/outputs/bundle/release/app-release.aab",
      # Store listing text lives in fastlane/metadata/android/<locale>/.
      # Screenshots/feature graphic aren't in the repo yet — skip so supply
      # doesn't wipe what's uploaded in the Console.
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
